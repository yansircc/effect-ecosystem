{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://effect-ecosystem-skill.local/manifest.schema.json",
  "title": ".effect-skill.json",
  "type": "object",
  "additionalProperties": false,
  "oneOf": [
    { "required": ["shape"], "not": { "required": ["packages"] } },
    { "required": ["packages"], "not": { "required": ["shape"] } }
  ],
  "allOf": [
    {
      "if": { "required": ["packages"] },
      "then": { "not": { "required": ["wranglerPath"] } }
    }
  ],
  "properties": {
    "shape": { "$ref": "#/$defs/shapeArray" },
    "packages": {
      "type": "array",
      "items": { "$ref": "#/$defs/package" }
    },
    "executableEdges": {
      "type": "array",
      "items": { "$ref": "#/$defs/executableEdge" }
    },
    "allowedAdapters": {
      "type": "array",
      "items": { "$ref": "#/$defs/adapterPath" }
    },
    "aiProviderTransports": {
      "type": "array",
      "items": { "$ref": "#/$defs/ownedPath" }
    },
    "generatedPaths": {
      "type": "array",
      "items": { "$ref": "#/$defs/generatedPath" }
    },
    "hostTooling": {
      "type": "array",
      "items": { "$ref": "#/$defs/ownedGlob" }
    },
    "testGlobs": {
      "type": "array",
      "items": { "$ref": "#/$defs/nonBlankString" }
    },
    "wranglerPath": { "$ref": "#/$defs/nonBlankString" },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "notProven": {
          "type": "array",
          "items": { "$ref": "#/$defs/notProven" }
        }
      }
    },
    "suppression": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lineLevel": { "$ref": "#/$defs/suppressionPolicy" },
        "manifestPath": { "$ref": "#/$defs/suppressionPolicy" }
      }
    }
  },
  "$defs": {
    "nonBlankString": {
      "type": "string",
      "pattern": "\\S"
    },
    "shape": {
      "enum": [
        "http-server",
        "http-client",
        "db:pg",
        "db:mysql",
        "db:sqlite",
        "db:d1",
        "db:clickhouse",
        "ai",
        "rpc",
        "frontend",
        "node",
        "bun",
        "browser",
        "worker",
        "library",
        "node-tool",
        "workflow"
      ]
    },
    "shapeArray": {
      "type": "array",
      "items": { "$ref": "#/$defs/shape" },
      "uniqueItems": true
    },
    "package": {
      "type": "object",
      "required": ["path", "shape"],
      "additionalProperties": false,
      "properties": {
        "path": { "$ref": "#/$defs/nonBlankString" },
        "shape": { "$ref": "#/$defs/shapeArray" },
        "dependencyOwner": { "enum": ["package-local", "workspace-root"] },
        "dependencyOwnerReason": { "$ref": "#/$defs/nonBlankString" },
        "wranglerPath": { "$ref": "#/$defs/nonBlankString" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "dependencyOwner": { "const": "workspace-root" } },
            "required": ["dependencyOwner"]
          },
          "then": { "required": ["dependencyOwnerReason"] }
        }
      ]
    },
    "ownedPath": {
      "type": "object",
      "required": ["path", "owner", "reason"],
      "additionalProperties": false,
      "properties": {
        "path": { "$ref": "#/$defs/nonBlankString" },
        "owner": { "$ref": "#/$defs/nonBlankString" },
        "reason": { "$ref": "#/$defs/nonBlankString" }
      }
    },
    "executableEdge": {
      "type": "object",
      "required": ["path", "owner", "reason", "execution"],
      "additionalProperties": false,
      "properties": {
        "path": { "$ref": "#/$defs/nonBlankString" },
        "owner": { "$ref": "#/$defs/nonBlankString" },
        "reason": { "$ref": "#/$defs/nonBlankString" },
        "execution": {
          "oneOf": [
            { "$ref": "#/$defs/processMainExecution" },
            { "$ref": "#/$defs/hostCallbackExecution" },
            { "$ref": "#/$defs/packageFacadeExecution" },
            { "$ref": "#/$defs/wranglerDoExecution" },
            { "$ref": "#/$defs/wranglerWorkerExecution" },
            { "$ref": "#/$defs/wranglerWorkflowExecution" },
            { "$ref": "#/$defs/handlerMapExecution" },
            { "$ref": "#/$defs/hostOptionsCallbackExecution" },
            { "$ref": "#/$defs/functionFacadeExecution" },
            { "$ref": "#/$defs/effectVitestExecution" }
          ]
        }
      }
    },
    "processMainExecution": {
      "type": "object",
      "required": ["lifecycle", "runner"],
      "additionalProperties": false,
      "properties": {
        "lifecycle": { "const": "process-main" },
        "runner": {
          "enum": [
            "NodeRuntime.runMain",
            "BunRuntime.runMain",
            "BrowserRuntime.runMain"
          ]
        }
      }
    },
    "hostCallbackExecution": {
      "type": "object",
      "required": ["lifecycle", "runners", "hosts"],
      "additionalProperties": false,
      "properties": {
        "lifecycle": { "const": "host-callback" },
        "runners": { "$ref": "#/$defs/effectRunnerSet" },
        "hosts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/hostCallback" }
        }
      }
    },
    "hostCallback": {
      "type": "object",
      "required": ["module", "export", "callbackArgument"],
      "additionalProperties": false,
      "properties": {
        "module": { "$ref": "#/$defs/nonBlankString" },
        "export": { "$ref": "#/$defs/nonBlankString" },
        "callbackArgument": { "type": "integer", "minimum": 0 }
      }
    },
    "packageFacadeExecution": {
      "type": "object",
      "required": ["lifecycle", "runners", "package"],
      "additionalProperties": false,
      "properties": {
        "lifecycle": { "const": "package-facade" },
        "runners": { "$ref": "#/$defs/effectRunnerSet" },
        "package": { "$ref": "#/$defs/packageFacadeBinding" }
      }
    },
    "packageFacadeBinding": {
      "type": "object",
      "required": ["name", "subpath", "export", "members"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/nonBlankString" },
        "subpath": { "$ref": "#/$defs/nonBlankString" },
        "export": { "$ref": "#/$defs/nonBlankString" },
        "members": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/packageFacadeMember" }
        }
      }
    },
    "packageFacadeMember": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind"],
          "additionalProperties": false,
          "properties": { "kind": { "const": "factory" } }
        },
        {
          "type": "object",
          "required": ["kind", "name"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "factory-local" },
            "name": { "$ref": "#/$defs/nonBlankString" }
          }
        },
        {
          "type": "object",
          "required": ["kind", "path"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "returned" },
            "path": {
              "type": "string",
              "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*(\\.[A-Za-z_$][A-Za-z0-9_$]*)*$"
            }
          }
        }
      ]
    },
    "wranglerDoExecution": {
      "type": "object",
      "required": ["lifecycle", "runners", "durableObject"],
      "additionalProperties": false,
      "properties": {
        "lifecycle": { "const": "wrangler-do" },
        "runners": { "$ref": "#/$defs/effectRunnerSet" },
        "durableObject": {
          "type": "object",
          "required": ["className", "methods"],
          "additionalProperties": false,
          "properties": {
            "className": { "$ref": "#/$defs/nonBlankString" },
            "methods": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/nonBlankString" }
            }
          }
        }
      }
    },
    "wranglerWorkerExecution": {
      "type": "object",
      "required": ["lifecycle", "runners", "worker"],
      "additionalProperties": false,
      "properties": {
        "lifecycle": { "const": "wrangler-worker" },
        "runners": { "$ref": "#/$defs/effectRunnerSet" },
        "worker": {
          "type": "object",
          "required": ["methods"],
          "additionalProperties": false,
          "properties": {
            "methods": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/nonBlankString" }
            }
          }
        }
      }
    },
    "wranglerWorkflowExecution": {
      "type": "object",
      "required": ["lifecycle", "runners", "workflow"],
      "additionalProperties": false,
      "properties": {
        "lifecycle": { "const": "wrangler-workflow" },
        "runners": { "$ref": "#/$defs/effectRunnerSet" },
        "workflow": {
          "type": "object",
          "required": ["className", "methods"],
          "additionalProperties": false,
          "properties": {
            "className": { "$ref": "#/$defs/nonBlankString" },
            "methods": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/nonBlankString" }
            }
          }
        }
      }
    },
    "handlerMapExecution": {
      "type": "object",
      "required": ["lifecycle", "runners", "handlerMap"],
      "additionalProperties": false,
      "properties": {
        "lifecycle": { "const": "handler-map" },
        "runners": { "$ref": "#/$defs/effectRunnerSet" },
        "handlerMap": {
          "type": "object",
          "required": ["factory"],
          "additionalProperties": false,
          "properties": {
            "factory": { "$ref": "#/$defs/nonBlankString" }
          }
        }
      }
    },
    "hostOptionsCallbackExecution": {
      "type": "object",
      "required": ["lifecycle", "runners", "host"],
      "additionalProperties": false,
      "properties": {
        "lifecycle": { "const": "host-options-callback" },
        "runners": { "$ref": "#/$defs/effectRunnerSet" },
        "host": {
          "type": "object",
          "required": ["module", "export", "optionsArgument", "property"],
          "additionalProperties": false,
          "properties": {
            "module": { "$ref": "#/$defs/nonBlankString" },
            "export": { "$ref": "#/$defs/nonBlankString" },
            "optionsArgument": { "type": "integer", "minimum": 0 },
            "property": { "$ref": "#/$defs/nonBlankString" }
          }
        }
      }
    },
    "functionFacadeExecution": {
      "type": "object",
      "required": ["lifecycle", "runners", "facade"],
      "additionalProperties": false,
      "properties": {
        "lifecycle": { "const": "function-facade" },
        "runners": { "$ref": "#/$defs/effectRunnerSet" },
        "facade": {
          "type": "object",
          "required": ["export", "members"],
          "additionalProperties": false,
          "properties": {
            "export": { "$ref": "#/$defs/nonBlankString" },
            "members": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/packageFacadeMember" }
            }
          }
        }
      }
    },
    "effectVitestExecution": {
      "type": "object",
      "required": ["lifecycle", "runners"],
      "additionalProperties": false,
      "properties": {
        "lifecycle": { "const": "effect-vitest" },
        "runners": { "$ref": "#/$defs/effectRunnerSet" }
      }
    },
    "effectRunnerSet": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/effectRunner" }
    },
    "effectRunner": {
      "enum": [
        "Effect.runCallback",
        "Effect.runCallbackWith",
        "Effect.runFork",
        "Effect.runForkWith",
        "Effect.runPromise",
        "Effect.runPromiseWith",
        "Effect.runPromiseExit",
        "Effect.runPromiseExitWith",
        "Effect.runSync",
        "Effect.runSyncWith",
        "Effect.runSyncExit",
        "Effect.runSyncExitWith"
      ]
    },
    "adapterPath": {
      "type": "object",
      "required": ["path", "owner", "reason", "rules"],
      "additionalProperties": false,
      "properties": {
        "path": { "$ref": "#/$defs/nonBlankString" },
        "owner": { "$ref": "#/$defs/nonBlankString" },
        "reason": { "$ref": "#/$defs/nonBlankString" },
        "rules": {
          "type": "array",
          "items": { "pattern": "^EFF[0-9]{3}$" },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "generatedPath": {
      "type": "object",
      "required": ["glob", "owner", "reason"],
      "additionalProperties": false,
      "properties": {
        "glob": { "$ref": "#/$defs/nonBlankString" },
        "owner": { "$ref": "#/$defs/nonBlankString" },
        "reason": { "$ref": "#/$defs/nonBlankString" }
      }
    },
    "ownedGlob": {
      "type": "object",
      "required": ["path", "owner", "reason"],
      "additionalProperties": false,
      "properties": {
        "path": { "$ref": "#/$defs/nonBlankString" },
        "owner": { "$ref": "#/$defs/nonBlankString" },
        "reason": { "$ref": "#/$defs/nonBlankString" }
      }
    },
    "notProven": {
      "type": "object",
      "required": ["id", "owner", "reason"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/nonBlankString" },
        "owner": { "$ref": "#/$defs/nonBlankString" },
        "reason": { "$ref": "#/$defs/nonBlankString" }
      }
    },
    "suppressionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requireReason": { "type": "boolean" },
        "requireOwner": { "type": "boolean" },
        "allowExpires": { "type": "boolean" }
      }
    }
  }
}
