{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://effect-ecosystem-skill.local/effect-capabilities.json",
  "schemaVersion": 2,
  "support": {
    "effect": {
      "major": 4,
      "range": ">=4.0.5 <5.0.0-0"
    },
    "typescript": {
      "major": 7,
      "version": "7.0.2"
    },
    "diagnostics": {
      "package": "@effect/tsgo",
      "version": "0.56.0",
      "compilerMarker": "+effect-tsgo."
    }
  },
  "references": [
    {
      "owner": "Contract Owner: effect-capabilities",
      "ref": "references/scanner-manifest.md §Contract Owner: effect-capabilities"
    },
    {
      "owner": "Capability: effect-v4",
      "ref": "references/effect-v4.md §Effect v4 Notes"
    }
  ],
  "importRoots": [
    "effect",
    "effect/ai",
    "effect/cli",
    "effect/cluster",
    "effect/devtools",
    "effect/encoding",
    "effect/eventlog",
    "effect/graphql",
    "effect/http",
    "effect/http-api",
    "effect/net",
    "effect/observability",
    "effect/persistence",
    "effect/process",
    "effect/reactivity",
    "effect/rpc",
    "effect/schema",
    "effect/socket",
    "effect/sql",
    "effect/testing",
    "effect/workers",
    "effect/workflow"
  ],
  "runtimeAdapters": [
    "@effect/platform-node",
    "@effect/platform-bun",
    "@effect/platform-browser",
    "@effect/sql-d1"
  ],
  "unstableBoundaries": [
    "HTTP/RPC/SQL/AI/Workflow APIs (effect/http, effect/rpc, effect/sql, effect/ai, effect/workflow) are accepted only behind typed API, LSP, and runtime bundle/dry-run gates.",
    "React state integration (@effect/atom-react, effect/reactivity) is stability-unstable and needs react >=19 <20; it is accepted only behind typed API and runtime proof."
  ],
  "packageRequirements": [
    {
      "ruleId": "EFF300",
      "shapes": [
        "db:pg"
      ],
      "allOf": [
        "effect",
        "@effect/sql-pg"
      ],
      "forbidden": [
        "pg"
      ]
    },
    {
      "ruleId": "EFF301",
      "shapes": [
        "db:mysql"
      ],
      "allOf": [
        "effect",
        "@effect/sql-mysql2"
      ],
      "forbidden": [
        "mysql2"
      ]
    },
    {
      "ruleId": "EFF302",
      "shapes": [
        "db:sqlite"
      ],
      "allOf": [
        "effect"
      ],
      "forbidden": [
        "better-sqlite3"
      ],
      "anyOf": [
        "@effect/sql-sqlite-node",
        "@effect/sql-sqlite-bun",
        "@effect/sql-sqlite-do",
        "@effect/sql-sqlite-wasm",
        "@effect/sql-libsql"
      ]
    },
    {
      "ruleId": "EFF303",
      "shapes": [
        "db:d1"
      ],
      "allOf": [
        "effect",
        "@effect/sql-d1"
      ]
    },
    {
      "ruleId": "EFF304",
      "shapes": [
        "db:clickhouse"
      ],
      "allOf": [
        "effect",
        "@effect/sql-clickhouse"
      ],
      "forbidden": [
        "@clickhouse/client"
      ]
    },
    {
      "ruleId": "EFF310",
      "shapes": [
        "http-server"
      ],
      "allOf": [
        "effect"
      ],
      "forbidden": [
        "express",
        "fastify",
        "hono",
        "koa",
        "hapi"
      ]
    },
    {
      "ruleId": "EFF311",
      "shapes": [
        "http-client"
      ],
      "allOf": [
        "effect"
      ],
      "forbidden": [
        "axios",
        "got",
        "node-fetch",
        "ky",
        "undici"
      ]
    },
    {
      "ruleId": "EFF312",
      "shapes": [
        "ai"
      ],
      "allOf": [
        "effect"
      ],
      "forbidden": [
        "openai",
        "@anthropic-ai/sdk",
        "@google/genai",
        "ai",
        "langchain"
      ],
      "providerPrefixAnyOf": [
        "@effect/ai-"
      ],
      "forbiddenPrefixes": [
        "@ai-sdk/",
        "@langchain/"
      ]
    }
  ],
  "v3LinePackages": [
    "@effect/platform",
    "@effect/sql",
    "@effect/sql-drizzle",
    "@effect/sql-kysely",
    "@effect/rpc",
    "@effect/ai",
    "@effect/ai-google",
    "@effect/ai-amazon-bedrock",
    "@effect/workflow",
    "@effect/cluster",
    "@effect/cli",
    "@effect/experimental",
    "@effect/printer",
    "@effect/typeclass",
    "@effect-atom/atom",
    "@effect-atom/atom-react"
  ]
}
