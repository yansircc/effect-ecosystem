{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://effect-ecosystem-skill.local/effect-capabilities.json",
  "schemaVersion": 2,
  "support": {
    "effect": {
      "major": 4,
      "range": ">=4.0.0-beta.97 <5.0.0-0"
    },
    "typescript": {
      "major": 7,
      "version": "7.0.2"
    },
    "diagnostics": {
      "package": "@effect/tsgo",
      "version": "0.21.0",
      "compilerMarker": "+effect-tsgo."
    }
  },
  "references": [
    {
      "owner": "Contract Owner: effect-capabilities",
      "ref": "references/scanner-manifest.md §Contract Owner: effect-capabilities"
    },
    {
      "owner": "Capability: effect-v4",
      "ref": "references/effect-v4.md §Effect v4 Notes"
    }
  ],
  "importRoots": [
    "effect",
    "effect/unstable/http",
    "effect/unstable/rpc",
    "effect/unstable/sql",
    "effect/unstable/ai",
    "effect/unstable/workflow"
  ],
  "runtimeAdapters": [
    "@effect/platform-node",
    "@effect/platform-bun",
    "@effect/platform-browser",
    "@effect/sql-d1"
  ],
  "unstableBoundaries": [
    "HTTP/RPC/SQL/AI/Workflow APIs are accepted only behind typed API, LSP, and runtime bundle/dry-run gates.",
    "React state integration is not v4-closed until a v4-compatible React adapter is proven."
  ],
  "packageRequirements": [
    {
      "ruleId": "EFF300",
      "shapes": [
        "db:pg"
      ],
      "allOf": [
        "effect"
      ],
      "forbidden": [
        "pg"
      ]
    },
    {
      "ruleId": "EFF301",
      "shapes": [
        "db:mysql"
      ],
      "allOf": [
        "effect"
      ],
      "forbidden": [
        "mysql2"
      ]
    },
    {
      "ruleId": "EFF302",
      "shapes": [
        "db:sqlite"
      ],
      "allOf": [
        "effect"
      ],
      "forbidden": [
        "better-sqlite3"
      ]
    },
    {
      "ruleId": "EFF304",
      "shapes": [
        "db:clickhouse"
      ],
      "allOf": [
        "effect"
      ],
      "forbidden": [
        "@clickhouse/client"
      ]
    },
    {
      "ruleId": "EFF310",
      "shapes": [
        "http-server"
      ],
      "allOf": [
        "effect"
      ],
      "forbidden": [
        "express",
        "fastify",
        "hono",
        "koa",
        "hapi"
      ]
    },
    {
      "ruleId": "EFF311",
      "shapes": [
        "http-client"
      ],
      "allOf": [
        "effect"
      ],
      "forbidden": [
        "axios",
        "got",
        "node-fetch"
      ]
    },
    {
      "ruleId": "EFF312",
      "shapes": [
        "ai"
      ],
      "allOf": [
        "effect"
      ],
      "forbidden": [
        "openai",
        "@anthropic-ai/sdk",
        "@google/genai"
      ],
      "providerPrefixAnyOf": [
        "@effect/ai-"
      ]
    }
  ]
}
