{
  "schemaVersion": 4,
  "scope": {
    "sourceExtensions": [
      ".ts",
      ".tsx",
      ".mts",
      ".cts",
      ".js",
      ".jsx",
      ".mjs",
      ".cjs"
    ],
    "declarationSuffixes": [
      ".d.ts",
      ".d.mts",
      ".d.cts"
    ],
    "defaultTests": {
      "infixes": [
        ".test",
        ".spec"
      ],
      "directories": [
        "__tests__",
        "test",
        "tests"
      ]
    },
    "ignoredDirectories": [
      ".git",
      ".cst",
      "node_modules",
      "dist-dev",
      "dist-installed"
    ],
    "walkIgnoredDirectories": [
      ".next",
      "coverage",
      "dist"
    ]
  },
  "actionOrder": [
    "source"
  ],
  "rules": [
    {
      "id": "EFF001",
      "name": "custom-try",
      "family": "source",
      "severity": "error",
      "profiles": [
        "core"
      ],
      "message": "custom",
      "references": [],
      "facts": [
        "source.code"
      ],
      "scanner": {
        "kind": "source-ast",
        "selector": "try-statement",
        "include": [
          "src/enforced/**"
        ],
        "exclude": [
          "src/enforced/skip.ts"
        ]
      }
    }
  ]
}
